#!/bin/sh /etc/rc.common
#
# MobileStation Web App - OpenWrt init script (procd)
# Runs the C++ backend.

START=95
USE_PROCD=1

start_service() {
    if [ ! -x /usr/bin/mswebapp ]; then
        echo "mswebapp: C++ backend not found: /usr/bin/mswebapp" >&2
        return 1
    fi

    if ! ip link show can0 >/dev/null 2>&1; then
        echo "mswebapp: CAN interface can0 not found" >&2
        return 1
    fi

    procd_open_instance
    procd_set_param command /usr/bin/mswebapp \
        --config /www \
        --can can0 \
        --host 0.0.0.0 \
        --port 6020 \
        --www /usr/share/mswebapp/www
    procd_set_param respawn
    procd_close_instance
}


stop_service() {
    : # procd handles stop
}