#!/bin/sh /etc/rc.common
#
# MobileStation Web App - OpenWrt init script (procd)
# Runs the C++ backend.

START=99
USE_PROCD=1
CAN_INTERFACE=can0

start_service() {
    if [ ! -x /usr/bin/mswebapp ]; then
        echo "mswebapp: C++ backend not found: /usr/bin/mswebapp" >&2
        return 1
    fi

    procd_open_instance
    procd_set_param command /bin/sh -c '
        can_interface=$0
        if [ -n "$can_interface" ] && ! ip link show dev "$can_interface" >/dev/null 2>&1; then
            echo "mswebapp: waiting for CAN interface $can_interface" >&2
        fi
        while [ -n "$can_interface" ] && ! ip link show dev "$can_interface" >/dev/null 2>&1; do
            sleep 1
        done
        exec /usr/bin/mswebapp \
            --config /www \
            --can "$can_interface" \
            --host 0.0.0.0 \
            --port 6020 \
            --www /usr/share/mswebapp/www
    ' "$CAN_INTERFACE"
    procd_set_param respawn
    procd_close_instance
}

stop_service() {
    : # procd handles stop
}