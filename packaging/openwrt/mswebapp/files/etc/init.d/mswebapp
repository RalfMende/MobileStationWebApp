#!/bin/sh /etc/rc.common
#
# MobileStation Web App - OpenWrt init script (procd)
# Runs the C++ backend.

START=95
USE_PROCD=1

# Defaults (override by editing or via future UCI integration)
PROG_CPP="/usr/bin/mswebapp"
CONFIG_DIR="/www"
HOST="0.0.0.0"
PORT=6020
CAN_IF="can0"
WWW_DIR="/usr/share/mswebapp/www" # frontend

start_service() {
    if [ -x "$PROG_CPP" ]; then
        if ! ip link show "$CAN_IF" >/dev/null 2>&1; then
            echo "mswebapp: CAN interface $CAN_IF not found" >&2
            return 1
        fi
        procd_open_instance
        procd_set_param command "$PROG_CPP" \
            --config "$CONFIG_DIR" \
            --can "$CAN_IF" \
            --host "$HOST" \
            --port "$PORT" \
            --www "$WWW_DIR"
        procd_set_param respawn
        procd_close_instance
    else
        echo "mswebapp: C++ backend not found: $PROG_CPP" >&2
        return 1
    fi
}

stop_service() {
    : # procd handles stop
}
